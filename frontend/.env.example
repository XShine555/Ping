# Copy to .env.local and adjust to match deploy/.env (backend). Not versioned.
VITE_API_BASE_URL=http://localhost:5211
# Must match the backend's PUBLIC_AUTH_URL exactly — it's baked into every token's issuer claim.
VITE_AUTH_AUTHORITY=http://host.docker.internal:8080
VITE_AUTH_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=http://localhost:3100/auth/callback
VITE_LIVEKIT_URL=ws://localhost:7880
